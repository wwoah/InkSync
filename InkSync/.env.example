# Real values belong in Render's dashboard, never in the repo.
# The render.yaml blueprint sets both of these automatically.

# ── Client (build time, baked into the bundle by Vite) ───────────────
# Absolute URL of the realtime server. MUST NOT be localhost in a deploy:
# the browser opens this socket, so localhost means the visitor's own machine.
# A bare hostname is fine; https:// is assumed.
VITE_SERVER_URL=inksync-server.onrender.com

# ── Server ───────────────────────────────────────────────────────────
# Origins allowed to open a socket, comma-separated. Must include the
# deployed frontend or the browser rejects the handshake.
CLIENT_ORIGIN=inksync-web.onrender.com,http://localhost:5173

# Render sets PORT itself; this is only the local fallback.
PORT=3001
